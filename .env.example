# Billie configuration. Copy to .env and adjust. Every value has a working default.

# --- Environment ---------------------------------------------------------------
# development: API open on localhost when no keys are set.
# production:  startup FAILS unless BILLIE_ADMIN_KEY is set, and BILLIE_API_KEY too
#              unless BILLIE_DEMO=1 (a public demo is open on purpose, with daily quotas).
BILLIE_ENV=development
BILLIE_API_KEY=
BILLIE_ADMIN_KEY=
BILLIE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BILLIE_RATE_LIMIT_PER_MINUTE=30

# --- Models (local, via Ollama) --------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Initial chat model; can be changed at runtime in the UI (Settings).
BILLIE_LLM_PROVIDER=ollama
BILLIE_LLM_MODEL=qwen3:4b-instruct
# Reads attached images when the chat model is text-only.
BILLIE_VISION_MODEL=gemma3:4b
# Multilingual embeddings for semantic search ("off" = keyword search only).
BILLIE_EMBED_MODEL=embeddinggemma
# Cloud chat models fall back to the local model on errors / rate limits (0 = no fallback).
BILLIE_LOCAL_FALLBACK=1
# Optional cloud vision provider (e.g. gemini), falling back to BILLIE_VISION_MODEL.
BILLIE_VISION_CLOUD=
BILLIE_VISION_CLOUD_MODEL=gemini-3.5-flash-lite

# --- Optional cloud providers (or paste keys in the UI instead) --------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Public demo mode (e.g. a hosted demo) ----------------------------------------
# Visitors see only their own chats; questions are capped per visitor IP and per day.
BILLIE_DEMO=0
BILLIE_DEMO_DAILY_LIMIT=150
BILLIE_DEMO_VISITOR_DAILY_LIMIT=25
# Sites allowed to show the UI in an iframe, comma-separated (e.g. https://huggingface.co).
BILLIE_FRAME_ANCESTORS=

# --- Limits -----------------------------------------------------------------------
BILLIE_HISTORY_TURNS=3
BILLIE_MAX_IMAGE_MB=8
BILLIE_MAX_DOCUMENT_MB=20
# BILLIE_DATA_DIR=./data
