# Billie configuration. Copy to .env and adjust. Every value has a working default.

# --- Environment ---------------------------------------------------------------
# development: API open on localhost when no keys are set.
# production:  startup FAILS unless BILLIE_API_KEY and BILLIE_ADMIN_KEY are set.
BILLIE_ENV=development
BILLIE_API_KEY=
BILLIE_ADMIN_KEY=
BILLIE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BILLIE_RATE_LIMIT_PER_MINUTE=30

# --- Models (local, via Ollama) --------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Initial chat model; can be changed at runtime in the UI (Settings).
BILLIE_LLM_PROVIDER=ollama
BILLIE_LLM_MODEL=qwen3:4b-instruct
# Reads attached images when the chat model is text-only.
BILLIE_VISION_MODEL=gemma3:4b
# Multilingual embeddings for semantic search ("off" = keyword search only).
BILLIE_EMBED_MODEL=embeddinggemma

# --- Optional cloud providers (or paste keys in the UI instead) --------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Limits -----------------------------------------------------------------------
BILLIE_HISTORY_TURNS=3
BILLIE_MAX_IMAGE_MB=8
BILLIE_MAX_DOCUMENT_MB=20
# BILLIE_DATA_DIR=./data
